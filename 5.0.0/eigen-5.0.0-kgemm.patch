index 0000000000000000000000000000000000000000..c67bb44e6808a91f954a70a729b3bcefc4781779
--- /dev/null
+++ b/unsupported/Eigen/CXX11/src/Tensor/TensorContractionKGemm.h
@@ -0,0 +1,437 @@
+// This file is part of Eigen, a lightweight C++ template library
+// for linear algebra.
+//
