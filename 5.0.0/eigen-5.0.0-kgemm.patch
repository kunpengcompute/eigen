+static inline void kgemm_pack_b_16(float *pb, const float *b, long int ldb, long int k)
+{
+    for (long int kk = 0; kk < k; ++kk) {
+        kgemm_copy_16_f32_no_overlap(pb + kk * 16, b + kk * ldb);
+    }
